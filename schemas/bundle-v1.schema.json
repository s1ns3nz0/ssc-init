{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ssc-init.dev/schemas/bundle-v1.schema.json",
  "title": "SSC Init verified bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "family", "version", "sequence", "keyId", "generatedAt", "validFrom", "validUntil", "payload"],
  "properties": {
    "schemaVersion": {"const": "ssc-init.bundle.v1"},
    "family": {"enum": ["ti", "policy"]},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "sequence": {"type": "integer", "minimum": 1},
    "keyId": {"type": "string", "minLength": 1, "maxLength": 128},
    "generatedAt": {"type": "string", "format": "date-time"},
    "validFrom": {"type": "string", "format": "date-time"},
    "validUntil": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"family": {"const": "ti"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/tiPayload"}}}
    },
    {
      "if": {"properties": {"family": {"const": "policy"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/policyPayload"}}}
    }
  ],
  "$defs": {
    "tiPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["records"],
      "properties": {"records": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/tiRecord"}}}
    },
    "tiRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "assetId", "verdict", "confidence", "sourceUrls", "retrievedAt", "validUntil", "withdrawn", "license", "redistributable"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "assetId": {"type": "string", "minLength": 1, "maxLength": 1024},
        "versionRange": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verdict": {"enum": ["known-malicious", "behaviorally-malicious", "suspicious", "needs-review", "no-finding"]},
        "confidence": {"enum": ["low", "medium", "high"]},
        "sourceUrls": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "format": "uri", "pattern": "^https://"}},
        "retrievedAt": {"type": "string", "format": "date-time"},
        "validUntil": {"type": "string", "format": "date-time"},
        "withdrawn": {"type": "boolean"},
        "license": {"type": "string", "minLength": 1, "maxLength": 256},
        "redistributable": {"type": "boolean"},
        "campaignIds": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "attackTechniques": {"type": "array", "maxItems": 64, "items": {"type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"}}
      }
    },
    "policyPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["denies", "allows", "exceptions", "tests"],
      "properties": {
        "denies": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/policyRule"}},
        "allows": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/policyAllow"}},
        "exceptions": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/policyException"}},
        "tests": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/policyTest"}},
        "retention": {"$ref": "#/$defs/retention"}
      }
    },
    "policyRule": {
      "type": "object", "additionalProperties": false, "required": ["id", "assetId"],
      "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 256}, "assetId": {"type": "string", "minLength": 1, "maxLength": 1024}}
    },
    "policyAllow": {
      "type": "object", "additionalProperties": false, "required": ["id", "assetId", "sha256"],
      "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 256}, "assetId": {"type": "string", "minLength": 1, "maxLength": 1024}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "policyException": {
      "type": "object", "additionalProperties": false, "required": ["id", "ruleId", "assetId", "approver", "reason", "ticket", "expiresAt"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256}, "ruleId": {"type": "string", "minLength": 1, "maxLength": 256},
        "assetId": {"type": "string", "minLength": 1, "maxLength": 1024}, "approver": {"type": "string", "minLength": 1, "maxLength": 256},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1024}, "ticket": {"type": "string", "minLength": 1, "maxLength": 256},
        "expiresAt": {"type": "string", "format": "date-time"}
      }
    },
    "policyTest": {
      "type": "object", "additionalProperties": false, "required": ["name", "assetId"],
      "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 256}, "assetId": {"type": "string", "minLength": 1, "maxLength": 1024}, "wantRule": {"type": "string", "maxLength": 256}}
    },
    "retention": {
      "type": "object", "additionalProperties": false, "required": ["snapshotsDays", "historyDays", "incidentsDays"],
      "properties": {"snapshotsDays": {"type": "integer", "minimum": 1, "maximum": 3650}, "historyDays": {"type": "integer", "minimum": 1, "maximum": 3650}, "incidentsDays": {"type": "integer", "minimum": 1, "maximum": 3650}}
    }
  }
}
